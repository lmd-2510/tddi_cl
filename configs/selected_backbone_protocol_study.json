{
  "study_id": "selected_protocols_tabm_ddigcn_v1",
  "status": "pilot_then_full",
  "relationship_to_tddi_study": "separate_backbone_generalization_study",
  "scope": {
    "backbones": ["tabm", "ddi_gcn"],
    "protocols_in_run_order": ["P4", "P6", "P0", "P2", "P3"],
    "method": "replay_distill_fixed_budget_uniform",
    "training_seeds": [0, 1, 2, 3, 4],
    "pilot_seed": 0
  },
  "dataset": {
    "name": "DDI2025",
    "splits": {
      "train": {"path": "train_extracted.parquet", "rows": 520841},
      "validation": {"path": "validation_extracted.parquet", "rows": 173614},
      "test": {"path": "test_extracted.parquet", "rows": 173614}
    },
    "split_ratio": [0.6, 0.2, 0.2],
    "num_classes": 178,
    "task_layout": [38, 20, 20, 20, 20, 20, 20, 20],
    "pair_disjoint": true
  },
  "shared_training": {
    "max_epochs_per_task": 20,
    "early_stopping_patience": 5,
    "checkpoint_metric": "validation_macro_f1_all_seen_classes",
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "microbatch_size": 256,
    "gradient_accumulation_steps": 4,
    "effective_batch_size": 1024,
    "classification_loss": "focal_gamma_1.0",
    "distillation_alpha": 1.0,
    "distillation_temperature": 2.0,
    "feature_distillation": "mse_weight_0.5",
    "total_memory_budget": 6800,
    "replay_draws_per_epoch_after_task0": 6800,
    "current_sampling": "each_current_sample_once_per_epoch",
    "old_class_sampling": "uniform_over_old_classes",
    "exemplar_ranking": "standardized_3780_descriptor_distance_to_class_mean",
    "device": "cuda",
    "precision": "float32"
  },
  "backbones": {
    "tabm": {
      "source": "https://github.com/yandex-research/tabm",
      "package": "tabm==0.0.3",
      "input": "3780 standardized numerical descriptors",
      "architecture": "TabM",
      "ensemble_members": 32,
      "blocks": 3,
      "block_width": 512,
      "dropout": 0.1,
      "training_prediction": "independent member losses",
      "inference_prediction": "mean member probabilities",
      "classifier": "expandable LinearEnsemble"
    },
    "ddi_gcn": {
      "source": "https://github.com/LabWeng/DDI-GCN",
      "implementation": "PyTorch port of categorical DDI-GCN",
      "input": "two molecular graphs from split SMILES metadata",
      "max_atoms": 65,
      "atom_feature_dim": 51,
      "bond_feature_dim": 10,
      "degree_range": [0, 5],
      "graph_convolution_depth": 8,
      "graph_width": 128,
      "layer_state_encoder": "bidirectional_GRU",
      "co_attention_dim": 65,
      "merger_hidden_dims": [100, 100, 100],
      "classifier": "expandable linear head with 178 final outputs"
    }
  },
  "protocols": {
    "P4": {"name": "constrained_mass_balanced", "role": "neutral_main_candidate", "signal": "train_only"},
    "P6": {"name": "difficulty_balanced", "role": "model_informed_candidate", "signal": "static_TDDI_train_plus_validation"},
    "P0": {"name": "random", "role": "reference", "signal": "seeded_random"},
    "P2": {"name": "head_to_tail", "role": "stress_test", "signal": "train_frequency"},
    "P3": {"name": "tail_to_head", "role": "counter_stress_test", "signal": "train_frequency"}
  },
  "fairness_notes": [
    "Every backbone uses identical split rows, task files, labels, method, loss, replay budget, optimizer-update exposure and seeds.",
    "DDI-GCN stores graph pair indices in replay, but exemplar identity is selected using the same standardized descriptor ranking as TabM/T-DDI.",
    "P6 is not backbone-neutral because its difficulty schedule was derived from a static T-DDI checkpoint; report it separately from the neutral P4/P0/P2/P3 comparison.",
    "Microbatch 256 follows the original DDI-GCN batch scale and protects the 16 GiB GPU; four-step accumulation preserves effective batch 1024."
  ],
  "resource_guard": {
    "sequential_jobs": true,
    "minimum_available_ram_gib": 12,
    "minimum_free_disk_gib": 50,
    "minimum_free_gpu_memory_mib": 10000,
    "skip_complete_runs": true,
    "refuse_incomplete_overwrite": true
  },
  "artifacts": {
    "graph_cache": "outputs/graph_cache/ddi_gcn",
    "run_root": "outputs/runs_selected_backbones",
    "runner": "scripts/run_selected_backbone_protocols.sh"
  }
}
