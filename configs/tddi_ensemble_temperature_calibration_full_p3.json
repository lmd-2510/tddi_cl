{
  "schema_version": 1,
  "method": "scalar_temperature_on_log_mean_probability",
  "fit_split": "validation",
  "objective": "negative_log_likelihood",
  "probability_epsilon": 1e-12,
  "optimizer": {
    "name": "safeguarded_newton_inverse_temperature",
    "min_temperature": 0.05,
    "max_temperature": 100.0,
    "max_iterations": 50,
    "tolerance": 1e-8,
    "batch_size": 8192
  },
  "calibration_bins": 15
}
