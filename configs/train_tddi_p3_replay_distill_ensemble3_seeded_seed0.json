{
  "schema_version": 1,
  "study_name": "tddi_ensemble3_replay_distill_p3_seed0_full8_seeded_v2",
  "experiment_seed": 0,
  "member_ids": [0, 1, 2],
  "ensemble": {"mode": "seeded"},
  "protocol": {
    "id": "P3",
    "name": "tail_to_head",
    "expected_task_count": 8,
    "expected_task_layout": [38, 20, 20, 20, 20, 20, 20, 20],
    "expected_class_count": 178,
    "task_file": "study_assets/task_protocols/tail_to_head_tasks.json"
  },
  "inputs": {
    "train": "train_extracted.parquet",
    "validation": "validation_extracted.parquet",
    "test": "test_extracted.parquet",
    "feature_columns": "study_assets/data_schema/feature_columns.json",
    "scaler": "study_assets/preprocessing/scaler.pkl"
  },
  "model": {
    "variant": "tddi_paper_member",
    "dropout": 0.2,
    "activation": "gelu",
    "normalization": "layernorm"
  },
  "training": {
    "method": "replay_distill_fixed_budget_uniform",
    "method_protocol": "replay_distill_fixed_budget_uniform",
    "optimizer": "adamw",
    "microbatch_size": 64,
    "effective_batch_size": 1024,
    "gradient_accumulation_steps": 16,
    "epochs": 20,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "patience": 5,
    "focal_gamma": 1.0,
    "total_memory_budget": 6800,
    "replay_draws_per_epoch": 6800,
    "replay_starts_at_task": 1,
    "distill_alpha": 1.0,
    "temperature": 2.0,
    "feature_distill_weight": 0.5,
    "checkpoint_resume_policy": {
      "enabled": true,
      "boundary": "task",
      "checkpoint_path": "checkpoints/latest_replay_distill_state.pt",
      "resume_cli": "--resume-replay-checkpoint",
      "skip_completed": true,
      "fail_incomplete_without_checkpoint": true
    },
    "device": "cuda"
  },
  "prediction_splits": ["validation", "test"],
  "outputs": {
    "root": "outputs/full/tddi_ensemble3_replay_distill_p3_seed0_8tasks_seeded_v2",
    "member_namespace": "member_{member_id}",
    "ensemble_namespace": "offline_ensemble",
    "manifest": "study_manifest.json"
  }
}
